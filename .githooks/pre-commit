#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"
if ! printf '%s\n' "$staged_files" | grep -Eq '(^Cargo\.(toml|lock)$|\.rs$|^rust-toolchain\.toml$|^rustfmt\.toml$)'; then
    exit 0
fi

echo "pre-commit: running cargo fmt --all --check"
cargo fmt --all --check
