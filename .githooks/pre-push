#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

clippy_cmd=(cargo clippy --all-targets -- -D warnings)

# Native cargo only works on aarch64 Linux with the static llama.cpp release
# present (build.rs requires STATIC_LLAMA_DIR). On any other host, run the same
# check in a linux/arm64 container against .llama-artifacts/extracted/.
if [[ "$(uname -sm)" == "Linux aarch64" && -n "${STATIC_LLAMA_DIR:-}" ]]; then
    echo "pre-push: running ${clippy_cmd[*]}"
    "${clippy_cmd[@]}"
else
    artifacts="$repo_root/.llama-artifacts/extracted"
    # Everything build.rs consumes from the release (CONTRACT.md "Release layout").
    required=(lib/libllama.a lib/libggml.a lib/libggml-cpu.a lib/libggml-base.a bindings.rs)
    for f in "${required[@]}"; do
        if [[ ! -f "$artifacts/$f" ]]; then
            echo "pre-push: $artifacts/$f not found — download and SHA-verify the" >&2
            echo "static-llama-cpp release into .llama-artifacts/extracted/ (see docs/development.md)" >&2
            exit 1
        fi
    done
    if ! docker info >/dev/null 2>&1; then
        echo "pre-push: docker daemon not reachable — install/start Docker to run clippy on this host (see docs/development.md)" >&2
        exit 1
    fi
    echo "pre-push: running ${clippy_cmd[*]} in linux/arm64 container"
    # Named volumes keep the rustup toolchain and cargo registry warm across runs;
    # target-linux-arm64/ keeps container build output separate from host target/.
    docker run --rm --platform linux/arm64 \
        -v "$repo_root":/work \
        -v "$artifacts":/opt/static-llama \
        -v ltembed-rustup:/usr/local/rustup \
        -v ltembed-cargo-registry:/usr/local/cargo/registry \
        -w /work \
        -e STATIC_LLAMA_DIR=/opt/static-llama \
        -e CARGO_TARGET_DIR=/work/target-linux-arm64 \
        rust:1.94.0 "${clippy_cmd[@]}"
fi
