#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

clippy_cmd=(cargo clippy --all-targets -- -D warnings)

# The artifact contract .github/scripts/fetch-static-llama.sh accepts (EXPECTED_CONTRACT).
# tests/test_pre_push_hook.py fails when the two differ.
readonly expected_contract=6

# check_release DIR NAME VARIANT TRIPLE
#
# Exit unless DIR (called NAME in messages) holds everything build.rs consumes from the
# release (CONTRACT.md "Release layout") and a build-info.json for the VARIANT this hook
# builds against. SHA verification is the download step's responsibility
# (fetch-static-llama.sh / manual download); the hook trusts a verified download and only
# validates layout + contract + target here.
check_release() {
    local dir="$1" name="$2" variant="$3" triple="$4" f contract actual_triple
    local required=(lib/libllama.a lib/libggml.a lib/libggml-cpu.a lib/libggml-base.a bindings.rs build-info.json)
    for f in "${required[@]}"; do
        if [[ ! -f "$dir/$f" ]]; then
            echo "pre-push: $dir/$f not found — download and SHA-verify the $variant variant" >&2
            echo "of the static-llama-cpp release into $name (see docs/development.md)" >&2
            exit 1
        fi
    done
    # Same checks as .github/scripts/fetch-static-llama.sh: fail closed on a release built
    # against a different artifact contract, or on the other architecture's variant, which
    # this build cannot link.
    contract="$(grep -o '"artifact_contract_version": *"[0-9]*"' "$dir/build-info.json" | grep -o '[0-9]*' || true)"
    if [[ "$contract" != "$expected_contract" ]]; then
        echo "pre-push: unexpected artifact_contract_version '${contract:-<missing>}' in $dir/build-info.json" >&2
        echo "(expected $expected_contract) — re-download the pinned release (see docs/development.md)" >&2
        exit 1
    fi
    actual_triple="$(grep -o '"target_triple": *"[^"]*"' "$dir/build-info.json" | cut -d'"' -f4 || true)"
    if [[ "$actual_triple" != "$triple" ]]; then
        echo "pre-push: unexpected target_triple '${actual_triple:-<missing>}' in $dir/build-info.json" >&2
        echo "(expected $triple) — $name must hold the $variant variant (see docs/development.md)" >&2
        exit 1
    fi
}

# Native cargo needs STATIC_LLAMA_DIR (build.rs requires it) and a host that can run one of
# the release's variants: aarch64 Linux, or x86_64 Linux whose CPU passes the same x86-64-v3
# check as CI. Otherwise an ARM64 host, such as macOS on Apple silicon, runs the same check in
# a linux/arm64 container against .llama-artifacts/extracted/. On any other CPU that
# container would run under emulation, which AGENTS.md forbids, so the hook fails instead.
host="$(uname -sm)"
native_variant=
native_triple=
not_native="STATIC_LLAMA_DIR is unset or empty"
if [[ -n "${STATIC_LLAMA_DIR:-}" ]]; then
    case "$host" in
        "Linux aarch64")
            native_variant=aarch64-graviton2
            native_triple=aarch64-unknown-linux-gnu
            ;;
        "Linux x86_64")
            # shellcheck source=.github/scripts/x86-64-v3.sh
            source "$repo_root/.github/scripts/x86-64-v3.sh"
            if cpu_check="$(x86_64_v3_check)"; then
                native_variant=x86_64-v3
                native_triple=x86_64-unknown-linux-gnu
            else
                not_native="$cpu_check"
            fi
            ;;
        *)
            not_native="no static llama.cpp variant runs natively on $host"
            ;;
    esac
fi

if [[ -n "$native_triple" ]]; then
    check_release "$STATIC_LLAMA_DIR" STATIC_LLAMA_DIR "$native_variant" "$native_triple"
    echo "pre-push: running ${clippy_cmd[*]}"
    "${clippy_cmd[@]}"
else
    case "${host##* }" in
        aarch64 | arm64) ;;
        *)
            echo "pre-push: not running clippy natively: $not_native" >&2
            echo "pre-push: nor in the linux/arm64 container, which would run under emulation on ${host##* }" >&2
            echo "Lint on x86-64-v3 Linux with STATIC_LLAMA_DIR set to the x86_64-v3 release, or on ARM64" >&2
            echo "hardware (see docs/development.md § \"Git hooks\")." >&2
            exit 1
            ;;
    esac
    artifacts="$repo_root/.llama-artifacts/extracted"
    check_release "$artifacts" .llama-artifacts/extracted/ aarch64-graviton2 aarch64-unknown-linux-gnu
    if ! docker info >/dev/null 2>&1; then
        echo "pre-push: docker daemon not reachable — install/start Docker to run clippy on this host (see docs/development.md)" >&2
        exit 1
    fi
    echo "pre-push: running ${clippy_cmd[*]} in linux/arm64 container"
    # Named volumes keep the rustup toolchain and cargo registry warm across runs;
    # target-linux-arm64/ keeps container build output separate from host target/.
    docker run --rm --platform linux/arm64 \
        -v "$repo_root":/work \
        -v "$artifacts":/opt/static-llama \
        -v ltembed-rustup:/usr/local/rustup \
        -v ltembed-cargo-registry:/usr/local/cargo/registry \
        -w /work \
        -e STATIC_LLAMA_DIR=/opt/static-llama \
        -e CARGO_TARGET_DIR=/work/target-linux-arm64 \
        rust:1.94.0 "${clippy_cmd[@]}"
fi
